{% comment %}
  Deep Formatting Test for Liquid
  Includes: nested blocks, filters, objects, loops, conditionals, and HTML.
{% endcomment %}

<div class="product-card">{% if product.available %}
<h2>{{ product.title | escape }}</h2>
      <p class="price">{{ product.price | money }}</p>
    {% for variant in product.variants %}
{% if variant.available %}
        <div class="variant">
          <label>
            <input type="radio" name="id" value="{{ variant.id }}" {% if forloop.first %}checked{% endif %}>
            {{ variant.title }} - {{ variant.price | money }}
          </label>
        </div>
      {% else %}
        <div class="variant sold-out">
<span>{{ variant.title }} - Sold Out</span>
        </div>
      {% endif %}
    {% endfor %}
  {% else %}
    <h2>{{ product.title }} (Sold Out)</h2>
  {% endif %}

  {% assign collection_handle = product.collections.first.handle %}
{% if collection_handle %}
    <a href="/collections/{{ collection_handle }}">Back to collection</a>
  {% endif %}
</div>

{% schema %}
  {
"name": "Product",
    "settings": [
      {
"type": "checkbox",
        "id": "show_vendor",
"label": "Show vendor"
      }
    ]
  }
{% endschema %}

{% style %}
  .product-card {
border: 1px solid #ccc;
    padding: 10px;
  }
{% endstyle %}

{% javascript %}
  console.log('Product loaded');
{% endjavascript %}
