{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2020",
    "outDir": "out",
    "lib": [
      "ES2020"
    ],
    "sourceMap": true,
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "exclude": [
    "node_modules",
    ".vscode-test",
    "test.ts",
    "test.js",
    "test.css",
    "test.less",
    "test.jsx",
    "test-broken.jsx",
    "test.tsx",
    "test.complex.ts",
    "test.complex.tsx"
  ]
}
