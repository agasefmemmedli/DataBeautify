{
  "name": "beautify-format",
  "displayName": "Beautify Format",
  "description": "Beautify and format JSON, XML, HTML, CSS, SCSS, SASS, LESS, JavaScript, TypeScript, Svelte and PHP files with keyboard shortcuts and context menu",
  "version": "0.5.0",
  "publisher": "DataBeautify",
  "author": {
    "name": "Aghasaf Mammadli"
  },
  "license": "MIT",
  "homepage": "https://github.com/agasefmemmedli",
  "repository": {
    "type": "git",
    "url": "https://github.com/agasefmemmedli"
  },
  "bugs": {
    "url": "https://github.com/agasefmemmedli"
  },
  "keywords": [
    "beautify",
    "format",
    "formatter",
    "json",
    "xml",
    "html",
    "css",
    "scss",
    "sass",
    "less",
    "typescript",
    "svelte",
    "php",
    "prettify",
    "indent"
  ],
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Formatters"
  ],
  "activationEvents": [
    "onCommand:beautify-format.beautify",
    "onLanguage:json",
    "onLanguage:xml",
    "onLanguage:html",
    "onLanguage:css",
    "onLanguage:scss",
    "onLanguage:sass",
    "onLanguage:less",
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onLanguage:javascriptreact",
    "onLanguage:typescriptreact",
    "onLanguage:vue",
    "onLanguage:svelte",
    "onLanguage:php"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "beautify-format.beautify",
        "title": "Beautify Format"
      },
      {
        "command": "beautify-format.formatSCSS",
        "title": "Beautify SCSS"
      },
      {
        "command": "beautify-format.formatSASS",
        "title": "Beautify SASS"
      },
      {
        "command": "beautify-format.formatLESS",
        "title": "Beautify LESS"
      },
      {
        "command": "beautify-format.formatJS",
        "title": "Beautify JavaScript"
      },
      {
        "command": "beautify-format.formatTS",
        "title": "Beautify TypeScript"
      },
      {
        "command": "beautify-format.formatJSX",
        "title": "Beautify JSX"
      },
      {
        "command": "beautify-format.formatTSX",
        "title": "Beautify TSX"
      },
      {
        "command": "beautify-format.formatVue",
        "title": "Beautify Vue"
      },
      {
        "command": "beautify-format.formatSvelte",
        "title": "Beautify Svelte"
      },
      {
        "command": "beautify-format.formatPHP",
        "title": "Beautify PHP"
      }
    ],
    "keybindings": [
      {
        "command": "beautify-format.beautify",
        "key": "ctrl+alt+b",
        "mac": "cmd+alt+b",
        "when": "editorTextFocus"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "beautify-format.beautify",
          "when": "editorLangId == json || editorLangId == xml || editorLangId == html || editorLangId == css || editorLangId == scss || editorLangId == sass || editorLangId == less || editorLangId == javascript || editorLangId == typescript || editorLangId == javascriptreact || editorLangId == typescriptreact || editorLangId == vue || editorLangId == svelte || editorLangId == php",
          "group": "1_modification"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/acorn": "^4.0.6",
    "@types/css": "^0.0.38",
    "@types/htmlhint": "^1.1.5",
    "@types/js-beautify": "^1.14.3",
    "@types/less": "^3.0.8",
    "@types/node": "16.x",
    "@types/vscode": "^1.74.0",
    "@typescript-eslint/eslint-plugin": "^5.45.0",
    "@typescript-eslint/parser": "^5.45.0",
    "@vscode/vsce": "^2.x.x",
    "eslint": "^8.28.0"
  },
  "dependencies": {
    "acorn": "^8.15.0",
    "css": "^3.0.0",
    "fast-xml-parser": "^5.3.6",
    "htmlhint": "^1.9.1",
    "js-beautify": "^1.15.4",
    "jsonrepair": "^3.13.2",
    "less": "^4.5.1",
    "php-parser": "^3.2.5",
    "sass": "^1.97.3",
    "sass-formatter": "^0.8.0",
    "svelte": "^5.51.1",
    "typescript": "^5.7.3",
    "xml-formatter": "^3.6.0"
  }
}
