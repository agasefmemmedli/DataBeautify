{
  "name": "beautify-format",
  "displayName": "Beautify Format",
  "description": "Beautify and format JSON, JSONC, XML, HTML, CSS, SCSS, SASS, LESS, JavaScript, TypeScript, JSX, TSX, Vue, Svelte, PHP, YAML, TOML, INI, ENV, CSV, GraphQL, Python, Java, Kotlin, C#, C++, Go, Rust, Ruby, Swift, Dart, Dockerfile, Shell Script, PowerShell, Terraform/HCL, Makefile, Nginx and SQL files with keyboard shortcuts and context menu",
  "version": "0.29.0",
  "publisher": "DataBeautify",
  "author": {
    "name": "Aghasaf Mammadli"
  },
  "license": "MIT",
  "homepage": "https://github.com/agasefmemmedli",
  "repository": {
    "type": "git",
    "url": "https://github.com/agasefmemmedli"
  },
  "bugs": {
    "url": "https://github.com/agasefmemmedli"
  },
  "keywords": [
    "beautify",
    "format",
    "formatter",
    "json",
    "xml",
    "html",
    "css",
    "scss",
    "sass",
    "less",
    "typescript",
    "svelte",
    "php",
    "go",
    "prettify",
    "indent"
  ],
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Formatters"
  ],
  "activationEvents": [
    "onCommand:beautify-format.beautify",
    "onLanguage:json",
    "onLanguage:jsonc",
    "onLanguage:xml",
    "onLanguage:html",
    "onLanguage:css",
    "onLanguage:scss",
    "onLanguage:sass",
    "onLanguage:less",
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onLanguage:javascriptreact",
    "onLanguage:typescriptreact",
    "onLanguage:vue",
    "onLanguage:svelte",
    "onLanguage:php",
    "onLanguage:yaml",
    "onLanguage:yml",
    "onLanguage:toml",
    "onLanguage:ini",
    "onLanguage:dotenv",
    "onLanguage:env",
    "onLanguage:csv",
    "onLanguage:graphql",
    "onLanguage:python",
    "onLanguage:java",
    "onLanguage:kotlin",
    "onLanguage:csharp",
    "onLanguage:cpp",
    "onLanguage:c",
    "onLanguage:go",
    "onLanguage:rust",
    "onLanguage:ruby",
    "onLanguage:swift",
    "onLanguage:dart",
    "onLanguage:dockerfile",
    "onLanguage:shellscript",
    "onLanguage:sh",
    "onLanguage:powershell",
    "onLanguage:terraform",
    "onLanguage:hcl",
    "onLanguage:terraform-vars",
    "onLanguage:makefile",
    "onLanguage:nginx",
    "onLanguage:sql"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "beautify-format.beautify",
        "title": "Beautify Format"
      },
      {
        "command": "beautify-format.formatSCSS",
        "title": "Beautify SCSS"
      },
      {
        "command": "beautify-format.formatSASS",
        "title": "Beautify SASS"
      },
      {
        "command": "beautify-format.formatLESS",
        "title": "Beautify LESS"
      },
      {
        "command": "beautify-format.formatJS",
        "title": "Beautify JavaScript"
      },
      {
        "command": "beautify-format.formatTS",
        "title": "Beautify TypeScript"
      },
      {
        "command": "beautify-format.formatJSX",
        "title": "Beautify JSX"
      },
      {
        "command": "beautify-format.formatTSX",
        "title": "Beautify TSX"
      },
      {
        "command": "beautify-format.formatVue",
        "title": "Beautify Vue"
      },
      {
        "command": "beautify-format.formatSvelte",
        "title": "Beautify Svelte"
      },
      {
        "command": "beautify-format.formatPHP",
        "title": "Beautify PHP"
      },
      {
        "command": "beautify-format.formatJSONC",
        "title": "Beautify JSONC"
      },
      {
        "command": "beautify-format.formatYAML",
        "title": "Beautify YAML"
      },
      {
        "command": "beautify-format.formatTOML",
        "title": "Beautify TOML"
      },
      {
        "command": "beautify-format.formatINI",
        "title": "Beautify INI"
      },
      {
        "command": "beautify-format.formatENV",
        "title": "Beautify ENV"
      },
      {
        "command": "beautify-format.formatCSV",
        "title": "Beautify CSV"
      },
      {
        "command": "beautify-format.formatGraphQL",
        "title": "Beautify GraphQL"
      },
      {
        "command": "beautify-format.formatPython",
        "title": "Beautify Python"
      },
      {
        "command": "beautify-format.formatJava",
        "title": "Beautify Java"
      },
      {
        "command": "beautify-format.formatKotlin",
        "title": "Beautify Kotlin"
      },
      {
        "command": "beautify-format.formatCSharp",
        "title": "Beautify C#"
      },
      {
        "command": "beautify-format.formatCPP",
        "title": "Beautify C++"
      },
      {
        "command": "beautify-format.formatGo",
        "title": "Beautify Go"
      },
      {
        "command": "beautify-format.formatRust",
        "title": "Beautify Rust"
      },
      {
        "command": "beautify-format.formatRuby",
        "title": "Beautify Ruby"
      },
      {
        "command": "beautify-format.formatSwift",
        "title": "Beautify Swift"
      },
      {
        "command": "beautify-format.formatDart",
        "title": "Beautify Dart"
      },
      {
        "command": "beautify-format.formatDockerfile",
        "title": "Beautify Dockerfile"
      },
      {
        "command": "beautify-format.formatShell",
        "title": "Beautify Shell Script"
      },
      {
        "command": "beautify-format.formatPowerShell",
        "title": "Beautify PowerShell"
      },
      {
        "command": "beautify-format.formatHCL",
        "title": "Beautify Terraform/HCL"
      },
      {
        "command": "beautify-format.formatMakefile",
        "title": "Beautify Makefile"
      },
      {
        "command": "beautify-format.formatNginx",
        "title": "Beautify Nginx"
      },
      {
        "command": "beautify-format.formatSQL",
        "title": "Beautify SQL"
      }
    ],
    "keybindings": [
      {
        "command": "beautify-format.beautify",
        "key": "ctrl+alt+b",
        "mac": "cmd+alt+b",
        "when": "editorTextFocus"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "beautify-format.beautify",
          "when": "editorLangId == json || editorLangId == jsonc || editorLangId == xml || editorLangId == html || editorLangId == css || editorLangId == scss || editorLangId == sass || editorLangId == less || editorLangId == javascript || editorLangId == typescript || editorLangId == javascriptreact || editorLangId == typescriptreact || editorLangId == vue || editorLangId == svelte || editorLangId == php || editorLangId == yaml || editorLangId == yml || editorLangId == toml || editorLangId == ini || editorLangId == dotenv || editorLangId == env || editorLangId == csv || editorLangId == graphql || editorLangId == python || editorLangId == java || editorLangId == kotlin || editorLangId == csharp || editorLangId == cpp || editorLangId == c || editorLangId == go || editorLangId == rust || editorLangId == ruby || editorLangId == swift || editorLangId == dart || editorLangId == dockerfile || editorLangId == shellscript || editorLangId == sh || editorLangId == powershell || editorLangId == terraform || editorLangId == hcl || editorLangId == terraform-vars || editorLangId == makefile || editorLangId == nginx || editorLangId == sql",
          "group": "1_modification"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run bundle",
    "compile": "tsc -p ./",
    "bundle": "node esbuild.js",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/acorn": "^4.0.6",
    "@types/css": "^0.0.38",
    "@types/htmlhint": "^1.1.5",
    "@types/ini": "^4.1.1",
    "@types/js-beautify": "^1.14.3",
    "@types/less": "^3.0.8",
    "@types/node": "^16.18.126",
    "@types/vscode": "^1.74.0",
    "@typescript-eslint/eslint-plugin": "^5.45.0",
    "@typescript-eslint/parser": "^5.45.0",
    "@vscode/vsce": "^2.x.x",
    "esbuild": "^0.27.3",
    "eslint": "^8.28.0",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "acorn": "^8.15.0",
    "antlr4ts": "^0.5.0-alpha.4",
    "css": "^3.0.0",
    "fast-xml-parser": "^5.3.6",
    "graphql": "^16.12.0",
    "htmlhint": "^1.9.1",
    "ini": "^6.0.0",
    "java-ast": "^0.4.1",
    "js-beautify": "^1.15.4",
    "jsonc-parser": "^3.3.1",
    "jsonrepair": "^3.13.2",
    "less": "^4.5.1",
    "php-parser": "^3.2.5",
    "python-ast": "^0.1.0",
    "sass": "^1.97.3",
    "sass-formatter": "^0.8.0",
    "smol-toml": "^1.6.0",
    "svelte": "^5.51.1",
    "xml-formatter": "^3.6.0",
    "yaml": "^2.8.2"
  }
}
