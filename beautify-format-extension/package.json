{
  "name": "beautify-format",
  "displayName": "Beautify Format",
  "description": "Beautify and format JSON, JSONC, XML, SQL and PL/SQL with a keyboard shortcut. Fixes common syntax errors safely and never writes a result that changes your data or code.",
  "version": "1.0.0",
  "publisher": "DataBeautify",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#1F2430",
    "theme": "dark"
  },
  "author": {
    "name": "Aghasaf Mammadli"
  },
  "license": "MIT",
  "homepage": "https://github.com/agasefmemmedli/DataBeautify/tree/main/beautify-format-extension#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/agasefmemmedli/DataBeautify.git",
    "directory": "beautify-format-extension"
  },
  "bugs": {
    "url": "https://github.com/agasefmemmedli/DataBeautify/issues"
  },
  "keywords": [
    "beautify",
    "format",
    "formatter",
    "json",
    "jsonc",
    "xml",
    "sql",
    "plsql",
    "oracle",
    "prettify"
  ],
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Formatters"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "beautify-format.beautify",
        "title": "Beautify Format"
      },
      {
        "command": "beautify-format.formatJSON",
        "title": "Beautify JSON"
      },
      {
        "command": "beautify-format.formatXML",
        "title": "Beautify XML"
      },
      {
        "command": "beautify-format.formatJSONC",
        "title": "Beautify JSONC"
      },
      {
        "command": "beautify-format.formatSQL",
        "title": "Beautify SQL"
      }
    ],
    "keybindings": [
      {
        "command": "beautify-format.beautify",
        "key": "ctrl+alt+b",
        "mac": "cmd+alt+b",
        "when": "editorTextFocus"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "beautify-format.beautify",
          "when": "editorLangId =~ /^(json|jsonc|xml|xsl|sql|plsql|oraclesql|pgsql|mysql|tsql|mssql|sqlite)$/",
          "group": "1_modification"
        }
      ]
    },
    "configuration": {
      "title": "Beautify Format",
      "properties": {
        "beautifyFormat.xml.sortAttributes": {
          "type": "boolean",
          "default": false,
          "description": "Sort XML attributes (id, class, name, src, href, type first, then alphabetically). Off by default to keep diffs small."
        },
        "beautifyFormat.sql.dialect": {
          "type": "string",
          "enum": [
            "auto",
            "sql",
            "plsql",
            "postgresql",
            "mysql",
            "mariadb",
            "transactsql",
            "sqlite",
            "bigquery",
            "snowflake",
            "redshift",
            "db2",
            "db2i",
            "hive",
            "spark",
            "trino",
            "n1ql",
            "singlestoredb",
            "tidb",
            "duckdb",
            "clickhouse"
          ],
          "default": "auto",
          "description": "SQL dialect. \"auto\" uses the language mode (e.g. plsql) or recognizes PL/SQL code, otherwise tries standard SQL, PostgreSQL, MySQL, T-SQL and PL/SQL."
        },
        "beautifyFormat.sql.keywordCase": {
          "type": "string",
          "enum": [
            "preserve",
            "upper",
            "lower"
          ],
          "default": "preserve",
          "description": "Case of SQL keywords."
        }
      }
    },
    "languages": [
      {
        "id": "plsql",
        "aliases": [
          "PL/SQL",
          "plsql"
        ],
        "extensions": [
          ".pls",
          ".plsql",
          ".pks",
          ".pkb",
          ".pck",
          ".prc",
          ".fnc",
          ".trg",
          ".tps",
          ".tpb"
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run bundle",
    "compile": "tsc -p ./",
    "bundle": "node esbuild.cjs",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "lint": "eslint src --ext ts",
    "test": "mocha \"out/test/unit/**/*.test.js\"",
    "test:corpus": "npm run compile && node scripts/corpus-check.cjs"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^16.18.126",
    "@types/vscode": "^1.74.0",
    "@typescript-eslint/eslint-plugin": "^5.45.0",
    "@typescript-eslint/parser": "^5.45.0",
    "@vscode/vsce": "^2.x.x",
    "esbuild": "^0.27.3",
    "eslint": "^8.28.0",
    "mocha": "^11.7.5",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "fast-xml-parser": "^5.3.6",
    "jsonc-parser": "^3.3.1",
    "jsonrepair": "^3.13.2",
    "sql-formatter": "^15.9.0",
    "xml-formatter": "^3.6.0"
  }
}
