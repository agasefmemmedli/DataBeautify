{
  "name": "beautify-format",
  "displayName": "Beautify Format",
  "description": "Beautify and format JSON, XML, HTML, CSS, SCSS and SASS files with keyboard shortcuts and context menu",
  "version": "0.0.4",
  "publisher": "DataBeautify",
  "author": {
    "name": "Your Name"
  },
  "license": "MIT",
  "homepage": "https://github.com/your-username/beautify-format#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/beautify-format.git"
  },
  "bugs": {
    "url": "https://github.com/your-username/beautify-format/issues"
  },
  "keywords": [
    "beautify",
    "format",
    "formatter",
    "json",
    "xml",
    "html",
    "css",
    "scss",
    "sass",
    "prettify",
    "indent"
  ],
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Formatters"
  ],
  "activationEvents": [
    "onCommand:beautify-format.beautify",
    "onLanguage:json",
    "onLanguage:xml",
    "onLanguage:html",
    "onLanguage:css",
    "onLanguage:scss",
    "onLanguage:sass"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "beautify-format.beautify",
        "title": "Beautify Format"
      },
      {
        "command": "beautify-format.formatSCSS",
        "title": "Beautify SCSS"
      },
      {
        "command": "beautify-format.formatSASS",
        "title": "Beautify SASS"
      }
    ],
    "keybindings": [
      {
        "command": "beautify-format.beautify",
        "key": "ctrl+alt+b",
        "mac": "cmd+alt+b",
        "when": "editorTextFocus"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "beautify-format.beautify",
          "when": "editorLangId == json || editorLangId == xml || editorLangId == html || editorLangId == css || editorLangId == scss || editorLangId == sass",
          "group": "1_modification"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/css": "^0.0.38",
    "@types/htmlhint": "^1.1.5",
    "@types/js-beautify": "^1.14.3",
    "@types/node": "16.x",
    "@types/vscode": "^1.74.0",
    "@typescript-eslint/eslint-plugin": "^5.45.0",
    "@typescript-eslint/parser": "^5.45.0",
    "eslint": "^8.28.0",
    "typescript": "^4.9.3"
  },
  "dependencies": {
    "css": "^3.0.0",
    "fast-xml-parser": "^5.3.5",
    "htmlhint": "^1.9.1",
    "js-beautify": "^1.15.4",
    "jsonrepair": "^3.13.2",
    "sass": "^1.97.3",
    "sass-formatter": "^0.8.0",
    "xml-formatter": "^3.6.0"
  }
}
