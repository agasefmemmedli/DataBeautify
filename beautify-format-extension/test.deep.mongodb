// MongoDB Shell Test

use myDatabase
show collections

db.users.find({
    name: "Deep Formatting",
    $or: [
        { "address.city": { $in: ["New York", "London"] } },
        { age: { $gt: 25 } }
    ]
}).sort({ name: 1 }).limit(10)

db.orders.aggregate([
    { $match: { status: "completed" } },
    { $group: { _id: "$custId", total: { $sum: "$amount" } } },
    { $sort: { total: -1 } }
])

// Function definition
function updateUsers() {
    const cursor = db.users.find();
    while (cursor.hasNext()) {
        const user = cursor.next();
        printjson(user);
    }
}

// Shell commands mixed with JS
show dbs
updateUsers()
exit
