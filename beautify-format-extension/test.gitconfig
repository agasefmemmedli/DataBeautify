[user]
    name = John Doe
    email = john@example.com
[core]
    editor = code
    autocrlf = input
[remote "origin"]
    url = https://github.com/user/repo.git
    fetch = +refs/heads/*:refs/remotes/origin/*
[alias]
    st = status
    co = checkout
    br = branch
[branch "main"]
    remote = origin
    merge = refs/heads/main
