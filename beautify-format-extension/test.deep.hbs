{{#if isValid}}
<div class="container {{#if active}}active{{/if}}">
    <h1>Hello {{name}}</h1>
    {{!-- This is a comment --}}
    {{#each items}}
        <li data-id="{{this.id}}">
            {{> userPartial user=this}}
        </li>
    {{else}}
        <p>No items found</p>
    {{/each}}
</div>
{{else}}
    {{#unless isLoading}}
    <div class="error">
        Invalid State
    </div>
    {{/unless}}
{{/if}}
<script>
    const data = {
        id: {{id}},
        value: "{{value}}"
    };
</script>
