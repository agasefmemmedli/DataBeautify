---
import Layout from '../layouts/Layout.astro';
const title = "My Astro Site";
const items = ["Item 1", "Item 2", "Item 3"];
---

<Layout title={title}>
<main>
<h1>{title}</h1>
<ul>
{items.map((item) => (
<li>{item}</li>
))}
</ul>
</main>
</Layout>

<style>
main {
margin: auto;
padding: 1rem;
width: 800px;
max-width: calc(100% - 2rem);
color: white;
font-size: 20px;
line-height: 1.6;
}
</style>
