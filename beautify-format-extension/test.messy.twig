{% extends "base.html" %}
{% block content %}
<h1>{{ page.title|upper }}</h1>
<div class="articles">
{% for article in articles %}
<article class="article-item {% if loop.first %}first{% endif %}">
<h2><a href="{{ article.url }}">{{ article.title }}</a></h2>
<div class="meta">
Posted on {{ article.date|date("Y-m-d") }} by {{ article.author }}
</div>
<div class="body">
{% if article.excerpt %}
{{ article.excerpt|raw }}
<a href="{{ article.url }}">Read more...</a>
{% else %}
{{ article.body|raw }}
{% endif %}
</div>
</article>
{% else %}
<p>No articles found.</p>
{% endfor %}
</div>
{% endblock %}
